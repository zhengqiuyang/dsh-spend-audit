{
  "name": "dsh-spend-audit",
  "version": "0.1.0",
  "description": "Independent cost audit for DeepSeek Harness: deterministically replays session logs into a spend ledger (per call / per plugin / per model / per phase), prices tokens from a declarative table, and reconciles the recomputed totals against any self-reported meter. Zero LLM calls in the audit path",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-spend-audit": "bin/cli.js"
  },
  "files": [
    "lib",
    "bin",
    "prices",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/run-tests.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-agents",
    "cost-audit",
    "deterministic"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-spend-audit.git"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
